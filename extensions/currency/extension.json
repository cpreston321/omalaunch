{
  "schemaVersion": 1,
  "id": "omalaunch.currency",
  "capability": "currency",
  "mode": "query",
  "label": "Currency conversion",
  "icon": "󰃬",
  "description": "Press Enter to copy",
  "rootDescription": "Convert between currencies",
  "priority": 20,
  "requires": ["qalc", "wl-copy"],
  "match": {
    "all": ["^\\s*[+-]?(?:\\d|\\.\\d)", "\\b[A-Za-z]{3}\\b.*\\b(to|in)\\b.*\\b[A-Za-z]{3}\\b"],
    "none": ["\\b(mph|kph|kmh|mpg|psi|btu|cal|deg|rad|bar|atm|nmi|cup|tsp|day|min|sec|hrs|lbs|kgs|ohm|amp|rpm|ppm|dpi|kwh)\\b"]
  },
  "normalizeUnits": true,
  "command": ["qalc", "-t", "-m", "1500", "{query}"],
  "resultCommand": ["wl-copy", "--", "{result}"]
}
