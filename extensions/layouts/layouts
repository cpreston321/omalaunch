def build_document(slug, extension_dir):
    binary = os.path.join(extension_dir, "layouts")
    layout = load_layout(slug)
    name = layout.get("name", slug)
    windows = layout.get("windows", [])
    spaces = sorted({w.get("workspace", "?") for w in windows}, key=lambda n: (len(n), n))

    fields = []
    for window in windows[:32]:
        geometry = "%dx%d at %d,%d" % (
            window.get("size", [0, 0])[0], window.get("size", [0, 0])[1],
            window.get("at", [0, 0])[0], window.get("at", [0, 0])[1],
