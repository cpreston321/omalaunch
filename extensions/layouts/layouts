# --- commands --------------------------------------------------------------

def cmd_save(args):
    name = (args.name or "").strip()
    if not name:
        print("A layout name is required.", file=sys.stderr)
        return 1
    slug = slugify(name)
    if os.path.exists(layout_path(slug)) and not args.overwrite:
        suffix = 2
        while os.path.exists(layout_path("%s-%d" % (slug, suffix))):
            suffix += 1
        slug = "%s-%d" % (slug, suffix)
    layout = capture(exact=args.exact)
    layout["name"] = name
    write_layout(slug, layout)
    print("Saved “%s” with %d window(s)." % (name, len(layout["windows"])))
    return 0


def cmd_apply(args):
    if getattr(args, "detach", False):
        # Building a tiled layout opens each window in turn and waits for it to
        # map, which can take longer than the launcher stays alive. Hand the
        # work to a detached child so activating the row returns at once and
        # the build survives Omalaunch closing.
        sp = _subprocess()
        command = [sys.executable, os.path.abspath(__file__), "apply", args.slug]
        if getattr(args, "tiled", False):
            command.append("--tiled")
        if getattr(args, "launch", False):
            command.append("--launch")
        try:
            sp.Popen(command, start_new_session=True, stdout=sp.DEVNULL,
                     stderr=sp.DEVNULL, stdin=sp.DEVNULL)
        except OSError as error:
            print(str(error), file=sys.stderr)
            return 1
        print("Building layout…")
        return 0

    if getattr(args, "tiled", False):
        launched, parked = apply_tiled(args.slug)
        note = "Tiled %d freshly opened window(s)" % launched
        if parked:
            note += "; parked %d existing window(s) on a spare workspace" % parked
        print(note + ".")
        return 0
    applied, missing = apply_layout(args.slug, launch=args.launch)
    print("Applied %d window(s); %d had no match." % (applied, missing))
    return 0


def cmd_delete(args):
    try:
        os.remove(layout_path(args.slug))
    except FileNotFoundError:
        print("No such layout.", file=sys.stderr)
        return 1
    print("Deleted.")
    return 0


def cmd_rename(args):
    name = (args.name or "").strip()
    if not name:
        print("A layout name is required.", file=sys.stderr)
        return 1
    layout = load_layout(args.slug)
    layout["name"] = name
    new_slug = slugify(name)
    if new_slug != args.slug and os.path.exists(layout_path(new_slug)):
        new_slug = args.slug
    write_layout(new_slug, layout)
    if new_slug != args.slug:
        os.remove(layout_path(args.slug))
    print("Renamed to “%s”." % name)
    return 0


def cmd_list(args):
    for layout in load_all():
        print("%-24s %s" % (layout["slug"], describe(layout)))
    return 0


USAGE = """usage: layouts <command> [args]

  menu [--dir D]            emit the dynamic menu
  preview-menu [--dir D]    emit the preview submenu
  document SLUG [--dir D]   emit a layout's detail document
  save NAME [--exact] [--overwrite]
  apply SLUG [--launch] [--tiled] [--detach]
  delete SLUG
  rename SLUG NAME
  list
"""


class Args(object):
    """Minimal stand-in for the argparse namespace this used to build."""

    def __init__(self, **fields):
        self.__dict__.update(fields)


def take_option(argv, name):
    """Pull `--name VALUE` out of argv, returning the value or ''."""
    if name in argv:
        at = argv.index(name)
        if at + 1 < len(argv):
            value = argv[at + 1]
            del argv[at:at + 2]
            return value
        del argv[at]
    return ""


def take_flag(argv, name):
    if name in argv:
        argv.remove(name)
        return True
    return False


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        sys.stdout.write(USAGE)
        return 0 if argv else 2

    command = argv.pop(0)
    extension_dir = take_option(argv, "--dir")
    if not extension_dir:
        extension_dir = os.path.dirname(os.path.abspath(__file__))

    if command == "menu":
        json.dump(build_menu(extension_dir), sys.stdout)
        return 0
    if command == "preview-menu":
        json.dump(build_preview_menu(extension_dir), sys.stdout)
        return 0
    if command == "document":
        if not argv:
            print("document needs a layout slug.", file=sys.stderr)
            return 2
        json.dump(build_document(argv[0], extension_dir), sys.stdout)
        return 0

    if command == "save":
        exact = take_flag(argv, "--exact")
        overwrite = take_flag(argv, "--overwrite")
        if not argv:
            print("save needs a layout name.", file=sys.stderr)
            return 2
        return cmd_save(Args(name=argv[0], exact=exact, overwrite=overwrite))
    if command == "apply":
        launch = take_flag(argv, "--launch")
        tiled = take_flag(argv, "--tiled")
        detach = take_flag(argv, "--detach")
        if not argv:
            print("apply needs a layout slug.", file=sys.stderr)
            return 2
        return cmd_apply(Args(slug=argv[0], launch=launch, tiled=tiled, detach=detach))
    if command == "delete":
        if not argv:
            print("delete needs a layout slug.", file=sys.stderr)
            return 2
        return cmd_delete(Args(slug=argv[0]))
    if command == "rename":
        if len(argv) < 2:
            print("rename needs a slug and a new name.", file=sys.stderr)
            return 2
        return cmd_rename(Args(slug=argv[0], name=argv[1]))
    if command == "list":
        return cmd_list(Args())

    sys.stdout.write(USAGE)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as error:  # surfaced by Omalaunch as a failed command
        print(str(error), file=sys.stderr)
        sys.exit(1)
